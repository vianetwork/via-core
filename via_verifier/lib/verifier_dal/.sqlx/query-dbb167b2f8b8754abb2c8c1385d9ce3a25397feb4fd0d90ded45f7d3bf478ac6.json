  "query": "\n            SELECT\n                id,\n                l2_tx_hash,\n                l2_tx_log_index,\n                receiver,\n                value\n            FROM\n                via_withdrawals\n            WHERE\n                value >= $1 AND bridge_withdrawal_id IS NULL\n            ORDER BY\n                id\n            LIMIT $2\n            ",
